;
; swio.pio - WCH SDI single-wire debug protocol
;            (ported from picorvd singlewire.pio)
;
; Open-drain emulation via SIDESET on PINDIRS: the OUT-pin level is held
; at 0, so "side 1" drives the line LOW and "side 0" releases it
; (external 4.7k-10k pull-up idles the line HIGH).
;
; Frame (host -> target), all fields MSB-first:
;   start('1') + 7-bit ~addr + R/W(1=read, 0=write) + 32-bit ~data
; The host already bit-inverts address and data before queueing:
;   read : TX word = ((~addr & 0x7F) << 1) | 1   -> one RX word (reply)
;   write: TX word = ((~addr & 0x7F) << 1) | 0, then TX word = ~data
;
; Timing at clkdiv=12 (125MHz / 12 = 96 ns/tick), WCH "normal" mode:
;   start   : low 2-3T, release
;   '1' bit : low ~2T  (~192ns)
;   '0' bit : low ~8T  (~768ns)
;   stop    : high ~18T
; Read: host drives a 1T marker low, releases, samples the pin at ~500ns,
; repeats 32x. ISR shifts left (MSB-first) with autopush(32).
;
; SPDX-License-Identifier: BSD-3-Clause (matches picorvd MIT-compatible origin)
;

.program swio
.side_set 1

.wrap_target

start:
  pull                 side 0 [2] ; Pull the address word; let bus pull high 3T
  out y, 24            side 1 [1] ; Send the start bit (drive low 2T)
  nop                  side 0 [2] ; Release start bit, pull up 3T

addr_loop:
  out x, 1             side 1 [0] ; Short pulses are ~2T
  jmp !x, addr_zero    side 1 [0]
  nop                  side 1 [5] ; Long pulses are ~8T
addr_zero:
  jmp !osre, addr_loop side 0 [2] ; End the bit, pull up 3T

  ; Branch on the low bit of the address word (the R/W bit).
  jmp !x, op_write     side 0 [0] ; bit 0 -> WRITE (host sends ~data)
  jmp op_read          side 0 [0] ; bit 1 -> READ

op_read:
  set x, 31            side 0 [0]

read_loop:                        ; Loop time ~1100ns
  nop                  side 1 [1] ; Start pulse; target drives low, holds ~800ns for '0'
  nop                  side 0 [2] ; Release; wait for pin to rise if target idle
  in pins, 1           side 0 [2] ; Sample pin (~500ns), then wait for target release
  jmp x--, read_loop   side 0 [2]

  nop                  side 0 [6] ; Stop: high ~18T total
  jmp start            side 0 [10]

op_write:
  pull                 side 0 [1] ; Pull the data word (~data)

write_loop:
  out x, 1             side 1 [0]
  jmp !x, data_zero    side 1 [0]
  nop                  side 1 [5]
data_zero:
  jmp !osre, write_loop side 0 [2]

  nop                  side 0 [6] ; Stop: high ~18T total
  jmp start            side 0 [10]

.wrap